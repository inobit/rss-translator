# ============================================================
# instabox box 定时任务环境变量
# 复制为 .env（不要提交到仓库），或按需改为 .env.example
# ============================================================

# -- Cloudflare KV（box 读写 CF KV 用）--
# CLOUDFLARE_ACCOUNT_ID：Cloudflare 账户 ID（非密钥）。
# 在 CF Dashboard 首页左下角 "Account ID" 查看；本仓库 config.example.yaml 的 providers 里也能看到。
CLOUDFLARE_ACCOUNT_ID=

# CF_KV_API_TOKEN：需到 Cloudflare Dashboard 创建自定义 API Token：
#   右上角头像 → My Profile → API Tokens → Create Token → Custom
#   权限：Workers KV Storage → Edit，命名空间指向 RSS_CACHE + RSS_CONFIG 两个 namespace
CF_KV_API_TOKEN=

# CF_KV_CONFIG_ID / CF_KV_CACHE_ID 是 KV namespace ID（CF_KV_CONFIG_ID=RSS_CONFIG，CF_KV_CACHE_ID=RSS_CACHE）
# 非密钥，可从本仓库 wrangler.toml 的 [[kv_namespaces]] 段直接复制，
# 或运行 `npx wrangler kv namespace list` 查看；重建时用 wrangler create 返回的 ID。
CF_KV_CONFIG_ID=
CF_KV_CACHE_ID=

# -- instabox 鉴权 --
# 必须与 Worker 的 secret INSTABOX_TOKEN 同值
INSTABOX_TOKEN=

# -- box 监听端口（可选，默认 8788）--
INSTABOX_PORT=8788

# -- 翻译 API Key（key 名必须与 wrangler secrets / config.yaml providers 一致）--
INO2API_API_KEY=

# -- box 运行时参数（可选，均有默认值）--
# 后台任务 watchdog 时长（毫秒），默认 1800000（30 分钟）
BOX_WATCHDOG_MS=1800000
# 文章翻译并发度，默认 5
BOX_ARTICLE_CONCURRENCY=5

# -- 可选 --
LOG_LEVEL=info
